# Complements .gitattributes: Keep LF, UTF-8.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

# Markdown uses trailing spaces as line breaks.
[*.md]
trim_trailing_whitespace = false
