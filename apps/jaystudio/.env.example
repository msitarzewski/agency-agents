# Copy to .env and fill in only what you use. Never commit .env.
ANTHROPIC_API_KEY=

# Optional, used by the connected MCP tools (VibeFrame, video-toolkit, ...)
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
KLING_API_KEY=
RUNWAY_API_SECRET=
REPLICATE_API_TOKEN=
MODAL_TOKEN_ID=
RUNPOD_API_KEY=

# Where the digitalsamba video toolkit is cloned (default ~/claude-code-video-toolkit)
VIDEO_TOOLKIT_ROOT=

# Server
JAYSTUDIO_HOST=127.0.0.1
JAYSTUDIO_PORT=4321
# Set a token if other AIOS services call this API/MCP endpoint
JAYSTUDIO_API_TOKEN=

# Free local model for "eco" tasks (optional): https://ollama.com
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
