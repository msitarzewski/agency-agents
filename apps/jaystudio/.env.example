# Copy to .env and fill in only what you use. Never commit .env.
ANTHROPIC_API_KEY=

# Optional, used by the connected MCP tools (VibeFrame, video-toolkit, ...)
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
KLING_API_KEY=
RUNWAY_API_SECRET=
REPLICATE_API_TOKEN=
MODAL_TOKEN_ID=
RUNPOD_API_KEY=

# Where the digitalsamba video toolkit is cloned (default ~/claude-code-video-toolkit)
VIDEO_TOOLKIT_ROOT=

# Server
JAYSTUDIO_HOST=127.0.0.1
JAYSTUDIO_PORT=4321
# Set a token if other AIOS services call this API/MCP endpoint
JAYSTUDIO_API_TOKEN=

# AIOS Brand OS connector (AIOS-CRM repo, brand-os/). Use a dedicated service account
# with role CONTENT_MANAGER or BRAND_MANAGER, never an OWNER/APPROVER.
AIOS_BRANDOS_URL=http://localhost:4000/api/v1
AIOS_BRANDOS_ORIGIN=http://localhost:3001
AIOS_BRANDOS_EMAIL=
AIOS_BRANDOS_PASSWORD=
# Needed only when the account belongs to more than one workspace
AIOS_BRANDOS_ORG_ID=

# Free local model for "eco" tasks (optional): https://ollama.com
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
